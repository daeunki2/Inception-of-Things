
Vagrant.configure("2") do |config|

  config.vm.box = "bento/ubuntu-24.04"

  config.vm.define "sunaS" do |server|
    server.vm.hostname = "sunaS"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provider "virtualbox" do |v|
      v.name = "sunaS"
      v.cpus = 4
      v.memory = 6144
    end

    # HOST의 p3 디렉터리를 VM에 연결
    server.vm.synced_folder "../p3", "/home/vagrant/p3"

    # HOST의 bonus 디렉터리를 VM에 연결
    server.vm.synced_folder "../bonus", "/home/vagrant/bonus"

    server.vm.provision "shell", path: "scripts/setup.sh"
  end

end
